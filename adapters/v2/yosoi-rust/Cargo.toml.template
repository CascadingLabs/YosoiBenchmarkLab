[package]
name = "yosoi-benchmark-v2"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
anyhow = "1"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sha2 = "0.10"
yosoi = { path = "__YOSOI_CRATE_PATH__" }
yosoi-documents = { path = "__YOSOI_DOCUMENTS_PATH__" }

[profile.release]
codegen-units = 1
lto = "thin"
strip = "debuginfo"
