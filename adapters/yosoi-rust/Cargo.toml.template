[package]
name = "yosoi-benchmark-yosoi-rust"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
anyhow = "1.0.100"
serde = { version = "1.0.228", features = ["derive"] }
serde_json = "1.0.149"
sha2 = "0.10.9"
yosoi = { path = "__YOSOI_CRATE_PATH__" }

[dev-dependencies]
criterion = { version = "0.7.0", default-features = false }

[[bench]]
name = "caveman"
harness = false

[profile.release]
codegen-units = 1
lto = "thin"
strip = "debuginfo"
