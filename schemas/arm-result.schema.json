{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yosoi.dev/benchmarks/schemas/arm-result.v1.json",
  "title": "Yosoi Benchmark Arm Record",
  "type": "object",
  "required": ["schemaVersion", "recordType", "runId", "armId"],
  "properties": {
    "schemaVersion": {"const": "yosoi.benchmark.arm-result.v1"},
    "recordType": {"enum": ["identity", "correctness", "sample", "resource", "summary"]},
    "runId": {"type": "string", "minLength": 1},
    "armId": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
    "taskId": {"type": "string"},
    "campaignIndex": {"type": "integer", "minimum": 0},
    "phase": {"enum": ["parse", "locate", "endToEnd", "coldProcess", "resource"]},
    "terminalStatus": {"enum": ["ok", "wrongOutput", "unsupported", "error", "timeout", "resourceLimit"]},
    "sampleIndex": {"type": "integer", "minimum": 0},
    "operations": {"type": "integer", "minimum": 1},
    "wallNs": {"type": "integer", "minimum": 0},
    "userCpuNs": {"type": ["integer", "null"], "minimum": 0},
    "systemCpuNs": {"type": ["integer", "null"], "minimum": 0},
    "aggregatePeakRssBytes": {"type": ["integer", "null"], "minimum": 0},
    "aggregateMeanRssBytes": {"type": ["integer", "null"], "minimum": 0},
    "aggregateP95RssBytes": {"type": ["integer", "null"], "minimum": 0},
    "rssAreaByteNs": {"type": ["integer", "null"], "minimum": 0},
    "rssSampleCount": {"type": ["integer", "null"], "minimum": 0},
    "rssSampleIntervalNs": {"type": ["integer", "null"], "minimum": 1},
    "processCount": {"type": ["integer", "null"], "minimum": 1},
    "inputBytes": {"type": ["integer", "null"], "minimum": 0},
    "inputElements": {"type": ["integer", "null"], "minimum": 0},
    "outputBytes": {"type": ["integer", "null"], "minimum": 0},
    "throughputInputBytesPerSecond": {"type": ["number", "null"], "minimum": 0},
    "throughputElementsPerSecond": {"type": ["number", "null"], "minimum": 0},
    "matchCount": {"type": "integer", "minimum": 0},
    "outputSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "product": {"type": "string"},
    "productVersion": {"type": "string"},
    "sourceRevision": {"type": ["string", "null"]},
    "runtime": {"type": "string"},
    "language": {"type": "string"},
    "backend": {"type": "string"},
    "streamingMode": {"enum": ["none", "incremental", "fullBuffer", "unknown"]},
    "timeToFirstOutputNs": {"type": ["integer", "null"], "minimum": 0},
    "inputBytesBeforeFirstOutput": {"type": ["integer", "null"], "minimum": 0},
    "artifactBytes": {"type": ["integer", "null"], "minimum": 0},
    "installedPackageBytes": {"type": ["integer", "null"], "minimum": 0},
    "runnableEnvironmentBytes": {"type": ["integer", "null"], "minimum": 0},
    "adapterRevision": {"type": "string"},
    "diagnostic": {"type": ["string", "null"], "maxLength": 4096},
    "plannedSamples": {"type": "integer", "minimum": 0},
    "observedSamples": {"type": "integer", "minimum": 0},
    "complete": {"type": "boolean"}
  },
  "additionalProperties": false
}
